# Anthropic API (required for --run-now; not needed for --mock)
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Teams Webhook (via Power Automate)
# Setup: Teams channel → ··· menu → Workflows → "Send webhook alerts to a channel" → Save → copy URL
# Note: legacy Office 365 Connectors are deprecated as of May 2026; use Power Automate workflows
TEAMS_WEBHOOK_URL=https://default...environment.api.powerplatform.com/...

# Email alerts (optional — requires SMTP AUTH enabled for the mailbox in M365 admin)
# Leave blank to disable email alerts; Teams webhook is the primary alert channel
# EMAIL_FROM=alerts@yourfirm.com
# EMAIL_TO=ops@yourfirm.com
# EMAIL_SMTP_HOST=smtp.office365.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=alerts@yourfirm.com
# EMAIL_SMTP_PASS=...

# Data storage paths (defaults shown)
DB_PATH=data/db/fees.db
RAW_DATA_DIR=data/raw
LOG_DIR=logs

# Claude model used for extraction (override if needed)
CLAUDE_MODEL=claude-sonnet-4-20250514
