# Anthropic API (required for --run-now; not needed for --mock)
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Teams Incoming Webhook
# Setup: Teams channel → ··· menu → Connectors → Incoming Webhook → Configure → copy URL
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...

# Email alerts (optional)
EMAIL_FROM=alerts@yourfirm.com
EMAIL_TO=ops@yourfirm.com
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=alerts@yourfirm.com
EMAIL_SMTP_PASS=...

# Data storage paths (defaults shown)
DB_PATH=data/db/fees.db
RAW_DATA_DIR=data/raw
LOG_DIR=logs

# Claude model used for extraction (override if needed)
CLAUDE_MODEL=claude-sonnet-4-20250514
